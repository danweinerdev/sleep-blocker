[Desktop Entry]
Type=Application
Name=Sleep Block
GenericName=Sleep Inhibitor
Comment=Keep the system awake by blocking suspend
# Absolute path or a bare name resolved via PATH; adjust to wherever the binary
# is installed.
Exec=sleep-block
# Resolved from the hicolor icon theme, which the package installs into. Uses
# the active-state icon, since that is what identifies the app in a launcher.
Icon=sleep-block
Terminal=false
Categories=Utility;
Keywords=sleep;suspend;inhibit;caffeine;awake;insomnia;
StartupNotify=true
# Must match the app_id the window sets, so the desktop associates the running
# window with this entry and shows its icon in the taskbar.
StartupWMClass=sleep-block
